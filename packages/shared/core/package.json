        "default": "./dist/conformance.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#server-engine": {
      "development": {
        "import": "./dist/dev/serverEngine.js",
        "require": "./dist/dev/serverEngine.cjs"
      },
      "import": "./dist/serverEngine.js",
      "require": "./dist/serverEngine.cjs"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-library.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "fast-check": "^4.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {}
}
