{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@adapttable/vue": ["./src/index.ts"],
      "@adapttable/vue/adapter": ["./src/adapter.ts"],
      "@adapttable/vue/features": ["./src/features.ts"],
      "@adapttable/vue/filters": ["./src/filters.ts"],
      "@adapttable/vue/header-filters": ["./src/header-filters.ts"],
      "@adapttable/vue/editing": ["./src/editing.ts"],
      "@adapttable/vue/batch-editing": ["./src/batch-editing.ts"],
      "@adapttable/vue/density": ["./src/density.ts"],
      "@adapttable/vue/fullscreen": ["./src/fullscreen.ts"],
      "@adapttable/vue/saved-views": ["./src/saved-views.ts"],
      "@adapttable/vue/cell-navigation": ["./src/cell-navigation.ts"],
      "@adapttable/vue/find-in-table": ["./src/find-in-table.ts"],
      "@adapttable/vue/status-bar": ["./src/status-bar.ts"],
      "@adapttable/vue/column-menu": ["./src/column-menu.ts"],
      "@adapttable/vue/column-selection": ["./src/column-selection.ts"],
      "@adapttable/vue/selection-stats": ["./src/selection-stats.ts"],
      "@adapttable/vue/bulk-actions": ["./src/bulk-actions.ts"],
      "@adapttable/vue/command-palette": ["./src/command-palette.ts"],
      "@adapttable/vue/context-menu": ["./src/context-menu.ts"],
      "@adapttable/vue/side-panel": ["./src/side-panel.ts"],
      "@adapttable/vue/print": ["./src/print.ts"],
      "@adapttable/vue/export-csv": ["./src/export-csv.ts"],
      "@adapttable/vue/export-pdf": ["./src/export-pdf.ts"],
      "@adapttable/vue/export-xlsx": ["./src/export-xlsx.ts"],
      "@adapttable/vue/formula": ["./src/formula.ts"],
      "@adapttable/vue/pivot": ["./src/pivot.ts"],
      "@adapttable/vue/stream": ["./src/stream.ts"],
      "@adapttable/vue/sparkline": ["./src/sparkline.ts"]
    }
  },
  "include": ["src", "test", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage", "test/types/invalid"],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  }
}
