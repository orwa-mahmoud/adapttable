      <section class="sec" id="get-started" aria-labelledby="gs-h">
        <div class="shell">
        <div class="sec__head">
          <span class="sec__kicker">Get started</span>
          <h2 class="sec__title" id="gs-h">Five lines to your first table.</h2>
          <p class="sec__lead">
