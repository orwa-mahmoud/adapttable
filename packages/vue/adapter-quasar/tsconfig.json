      "@adapttable/quasar/fullscreen": ["./src/fullscreen.ts"],
      "@adapttable/quasar/grouping": ["./src/grouping.ts"],
      "@adapttable/quasar/filters": ["./src/filters.ts"],
      "@adapttable/quasar/header-filters": ["./src/header-filters.ts"],
      "@adapttable/quasar/editing": ["./src/editing.ts"],
      "@adapttable/quasar/batch-editing": ["./src/batch-editing.ts"],
      "@adapttable/quasar/column-menu": ["./src/column-menu.ts"],
      "@adapttable/quasar/print": ["./src/print.ts"],
      "@adapttable/quasar/bulk-actions": ["./src/bulk-actions.ts"],
      "@adapttable/quasar/find-in-table": ["./src/find-in-table.ts"],
      "@adapttable/quasar/status-bar": ["./src/status-bar.ts"],
      "@adapttable/quasar/selection-stats": ["./src/selection-stats.ts"],
