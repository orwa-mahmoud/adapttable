{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@adapttable/vue-unstyled": ["./src/index.ts"],
      "@adapttable/vue-unstyled/*": ["./src/*.ts"],
      "@adapttable/ai-vue": ["../ai-vue/src/index.ts"],
      "@adapttable/ai": ["../../shared/ai/src/index.ts"],
      "@adapttable/ai/voice": ["../../shared/ai/src/voice.ts"]
    },
    "rootDirs": [".", "./.sfc-types"],
    "allowJs": true
  },
  "include": ["src", "test", "tsdown.config.ts", "vitest.config.ts", "browser"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test/types/invalid",
    ".sfc-types"
  ],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  }
}
