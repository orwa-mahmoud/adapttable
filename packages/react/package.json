{
  "name": "@adapttable/react",
  "version": "2.9.0",
  "description": "Headless React binding and structural Chrome for AdaptTable. Hooks subscribe to the framework-neutral engine in @adapttable/core.",
  "keywords": [
    "react",
    "data-table",
    "table",
    "headless",
    "headless-ui",
    "datagrid",
    "adapttable"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://orwa-mahmoud.github.io/adapttable/demo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.ts",
        "default": "./dist/adapter.js"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./features": {
      "import": {
        "types": "./dist/features.d.ts",
        "default": "./dist/features.js"
      },
      "require": {
        "types": "./dist/features.d.cts",
        "default": "./dist/features.cjs"
      }
    },
    "./formula": {
      "import": {
        "types": "./dist/formula.d.ts",
        "default": "./dist/formula.js"
      },
      "require": {
        "types": "./dist/formula.d.cts",
        "default": "./dist/formula.cjs"
      }
    },
    "./pivot": {
      "import": {
        "types": "./dist/pivot.d.ts",
        "default": "./dist/pivot.js"
      },
      "require": {
        "types": "./dist/pivot.d.cts",
        "default": "./dist/pivot.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.js"
      },
      "require": {
        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./sparkline": {
      "import": {
        "types": "./dist/sparkline.d.ts",
        "default": "./dist/sparkline.js"
      },
      "require": {
        "types": "./dist/sparkline.d.cts",
        "default": "./dist/sparkline.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@adapttable/core": "workspace:^",
    "@tanstack/react-virtual": "^3.14.10",
    "react-compiler-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
