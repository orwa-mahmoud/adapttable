---
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import FrameworkSwitch from "./FrameworkSwitch.astro";
---
<div class="site-brand">
  <SiteTitle><slot /></SiteTitle>
  <span class="mobile-framework"><FrameworkSwitch /></span>
</div>
<style>
  .site-brand { display: flex; align-items: center; gap: .5rem; min-width: 0; }
  .mobile-framework { display: inline-flex; }
  @media (min-width: 50rem) { .mobile-framework { display: none; } }
  @media (max-width: 24rem) {
    .site-brand { gap: .25rem; }
    .mobile-framework :global(select) { max-width: 4.8rem; font-size: .75rem; }
    .mobile-framework :global([data-framework-icon]) { display: none; }
  }
</style>
