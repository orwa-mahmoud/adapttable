{
  "name": "@adapttable/core",
  "version": "4.0.0",
  "description": "Framework-neutral AdaptTable engine — models, state, URL sync, and a unified client/server TableSource. Zero UI-kit or React imports.",
  "keywords": [
    "data-table",
    "table",
    "headless",
    "headless-ui",
    "datagrid",
    "server-side-pagination",
    "url-state",
    "infinite-scroll",
    "virtualized-table",
    "responsive-table",
    "rtl",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://adapttable.orwamahmoud.com/react/demo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/shared/core"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "development": "./dist/dev/index.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "development": "./dist/dev/index.cjs",
        "default": "./dist/index.cjs"
      }
    },
