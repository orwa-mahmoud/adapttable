{
  "name": "@adapttable/ai",
  "version": "0.1.0",
  "description": "Provider-neutral adaptive table capability discovery — catalog, describe and execute against a live AdaptTable without shipping a model SDK.",
  "keywords": [
    "react",
    "data-table",
    "ai",
    "agent",
    "tools",
    "adapttable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://orwa-mahmoud.github.io/adapttable/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/ai"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/json.d.ts",
        "default": "./dist/json.js"
      },
      "require": {
        "types": "./dist/json.d.cts",
        "default": "./dist/json.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/openai.d.ts",
        "default": "./dist/openai.js"
      },
      "require": {
        "types": "./dist/openai.d.cts",
        "default": "./dist/openai.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@adapttable/core": "workspace:^",
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
