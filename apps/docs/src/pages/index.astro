    <script>
      // Mouse wheel paginates the deck: one flick, one slide — and a
      // SUSTAINED scroll chains slide after slide, so the whole page can
      // be traversed in one go. The listener lives on window so the
      // pinned header/footer are scrollable territory too. Inertia tails
      // are filtered by an accumulation threshold that is higher inside
      // a continuous stream than after a pause, plus a rising-edge
      // shortcut for a fresh flick mid-stream.
      const deck = document.querySelector<HTMLElement>("main.deck");
      const deckMode = window.matchMedia("(min-width: 920px)");
      if (deck) {
        let animating = false;
        let inStream = false;
        let acc = 0;
        let lastT = 0;
        let prevDelta = 0;
        let settleTimer = 0;
        const settle = () => {
          animating = false;
          acc = 0;
        };
        deck.addEventListener("scrollend", settle);
        deck.addEventListener("scroll", () => {
          window.clearTimeout(settleTimer);
          settleTimer = window.setTimeout(settle, 150);
        });
        window.addEventListener(
          "wheel",
          (e) => {
            if (!deckMode.matches) return;
            const slide = (e.target as HTMLElement).closest(
              "main.deck > section"
            );
            if (slide) {
              const canDown =
                slide.scrollTop + slide.clientHeight < slide.scrollHeight - 1;
              const canUp = slide.scrollTop > 0;
              if ((e.deltaY > 0 && canDown) || (e.deltaY < 0 && canUp)) {
                return;
              }
            }
            if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
            e.preventDefault();
            const gap = e.timeStamp - lastT;
            lastT = e.timeStamp;
            const delta = Math.abs(e.deltaY);
            const rising = delta >= 80 && delta >= prevDelta * 1.5;
            prevDelta = delta;
            if (gap > 200) {
              inStream = false;
              acc = 0;
            }
            if (animating) return;
            acc += e.deltaY;
            const threshold = inStream && !rising ? 240 : 40;
            if (Math.abs(acc) < threshold) return;
            const w = deck.clientWidth;
            const current = Math.round(deck.scrollLeft / w);
            const idx = Math.max(
              0,
              Math.min(
                current + (acc > 0 ? 1 : -1),
                deck.children.length - 1
              )
            );
            acc = 0;
            // Boundary: nothing to do and nothing armed — no gesture debt.
            if (idx === current) return;
            animating = true;
            inStream = true;
            deck.children[idx]?.scrollIntoView({
              behavior: "smooth",
              inline: "start",
              block: "nearest",
            });
            // Safety: never stay locked if scrollend doesn't fire.
            window.setTimeout(settle, 1200);
          },
          { passive: false }
        );
      }

      // The nav tab of the slide on screen is marked active — instantly
      // on click, and tracked while sliding (works for the horizontal
      // deck and the mobile vertical flow alike).
      const navLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".nav__links a")
      );
      const setActive = (id: string) => {
        for (const link of navLinks) {
          const on = link.getAttribute("href") === `#${id}`;
          link.classList.toggle("is-on", on);
          if (on) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      };
      for (const link of navLinks) {
        link.addEventListener("click", () => {
          setActive((link.getAttribute("href") ?? "#").slice(1));
        });
      }
      const watcher = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(entry.target.id);
          }
        },
        { threshold: 0.35 }
      );
      for (const section of document.querySelectorAll("main.deck > section")) {
        watcher.observe(section);
      }

      // The demo's copy-to-clipboard affordance on the install pill.
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach(
        (btn) => {
          btn.addEventListener("click", () => {
            void navigator.clipboard?.writeText(btn.dataset.copy ?? "");
            btn.classList.add("ok");
            window.setTimeout(() => btn.classList.remove("ok"), 1200);
          });
        }
      );
    </script>
