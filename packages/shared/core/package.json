{
  "name": "@adapttable/core",
  "version": "3.3.0",
  "description": "Framework-neutral AdaptTable engine — models, state, URL sync, and a unified client/server TableSource. Zero UI-kit or React imports.",
  "keywords": [
    "data-table",
    "table",
    "headless",
    "headless-ui",
    "datagrid",
    "server-side-pagination",
    "url-state",
    "infinite-scroll",
    "virtualized-table",
    "responsive-table",
    "rtl",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://adapttable.orwamahmoud.com/react/demo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/shared/core"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./binding": {
      "import": {
        "types": "./dist/binding.d.ts",
        "default": "./dist/binding.js"
      },
      "require": {
        "types": "./dist/binding.d.cts",
        "default": "./dist/binding.cjs"
      }
    },
    "./xlsx": {
      "import": {
        "types": "./dist/xlsx.d.ts",
        "default": "./dist/xlsx.js"
      },
      "require": {
        "types": "./dist/xlsx.d.cts",
        "default": "./dist/xlsx.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./formula": {
      "import": {
        "types": "./dist/formula.d.ts",
        "default": "./dist/formula.js"
      },
      "require": {
        "types": "./dist/formula.d.cts",
        "default": "./dist/formula.cjs"
      }
    },
    "./pivot": {
      "import": {
        "types": "./dist/pivot.d.ts",
        "default": "./dist/pivot.js"
      },
      "require": {
        "types": "./dist/pivot.d.cts",
        "default": "./dist/pivot.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query.d.ts",
        "default": "./dist/query.js"
      },
      "require": {
        "types": "./dist/query.d.cts",
        "default": "./dist/query.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.js"
      },
      "require": {
        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tanstack/react-query": "^5.102.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "fast-check": "^4.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {}
}
