      <section class="sec" id="features" aria-labelledby="features-h">
        <div class="shell">
        <div class="sec__head">
          <span class="sec__kicker">The batteries</span>
          <h2 class="sec__title" id="features-h">
            Everything a data table owes you.
          </h2>
        </div>
        <div class="grid">
          {
            FEATURES.map((f, n) => (
              <article class="card" style={`--hue:${f.hue};--n:${n}`}>
                <div class="viz" aria-hidden="true">
                  {f.viz === "filter" && (
                    <>
                      <span class="viz-chip">Team: Core ✕</span>
                      <span class="viz-chip">Budget ≥ 25k ✕</span>
                      <span class="viz-chip viz-chip--ghost">+ Add filter</span>
                    </>
                  )}
                  {f.viz === "tiers" && (
                    <span class="viz-stack">
                      <i>data={"{rows}"}</i>
                      <i>onQueryChange(q)</i>
                      <i>TableSource</i>
                    </span>
                  )}
                  {f.viz === "url" && (
                    <span class="viz-url">
                      <i class="viz-dot" />
                      ?q=ada&amp;f_team=Core&amp;sort=name
                    </span>
                  )}
                  {f.viz === "rows" && (
                    <span class="viz-rows">
                      <i />
