{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["node", "vitest/globals"],
    "rootDirs": [".", "./.sfc-types"],
    "paths": {
      "@adapttable/quasar": ["./src/index.ts"],
      "@adapttable/quasar/*": ["./src/*.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts", "tsdown.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".sfc-types",
    "test/types/invalid"
  ],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  },
  "files": ["src/styles.d.ts"]
}
