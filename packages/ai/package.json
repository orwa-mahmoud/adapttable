{
  "name": "@adapttable/ai",
  "version": "0.1.0",
  "description": "Provider-neutral adaptive table capability discovery — catalog, describe and execute against a live AdaptTable without shipping a model SDK.",
  "keywords": [
    "data-table",
    "ai",
    "agent",
    "tools",
    "adapttable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://orwa-mahmoud.github.io/adapttable/demo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/ai"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/json.d.ts",
        "default": "./dist/json.js"
      },
      "require": {
        "types": "./dist/json.d.cts",
        "default": "./dist/json.cjs"
      }
    },
    "./openai": {
      "import": {
        "types": "./dist/openai.d.ts",
        "default": "./dist/openai.js"
      },
      "require": {
        "types": "./dist/openai.d.cts",
        "default": "./dist/openai.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      },
      "require": {
        "types": "./dist/http.d.cts",
        "default": "./dist/http.cjs"
      }
    },
    "./assistant": {
      "import": {
        "types": "./dist/assistant.d.ts",
        "default": "./dist/assistant.js"
      },
      "require": {
        "types": "./dist/assistant.d.cts",
        "default": "./dist/assistant.cjs"
      }
    },
    "./context": {
      "import": {
        "types": "./dist/context.d.ts",
        "default": "./dist/context.js"
      },
      "require": {
        "types": "./dist/context.d.cts",
        "default": "./dist/context.cjs"
      }
    },
    "./voice": {
      "import": {
        "types": "./dist/voice.d.ts",
        "default": "./dist/voice.js"
      },
      "require": {
        "types": "./dist/voice.d.cts",
        "default": "./dist/voice.cjs"
      }
    },
    "./webmcp": {
      "import": {
        "types": "./dist/webmcp.d.ts",
        "default": "./dist/webmcp.js"
      },
      "require": {
        "types": "./dist/webmcp.d.cts",
        "default": "./dist/webmcp.cjs"
      }
    },
    "./ag-ui": {
      "import": {
        "types": "./dist/agui.d.ts",
        "default": "./dist/agui.js"
      },
      "require": {
        "types": "./dist/agui.d.cts",
        "default": "./dist/agui.cjs"
      }
    },
    "./mcp-apps": {
      "import": {
        "types": "./dist/mcpApps.d.ts",
        "default": "./dist/mcpApps.js"
      },
      "require": {
        "types": "./dist/mcpApps.d.cts",
        "default": "./dist/mcpApps.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@adapttable/core": "2.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
