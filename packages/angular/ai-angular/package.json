{
  "name": "@adapttable/ai-angular",
  "version": "0.1.2",
  "description": "Angular bindings for AdaptTable AI — tableAgent, injectTableAssistant and injectSpeechInput.",
  "keywords": [
    "angular",
    "signals",
    "data-table",
    "ai",
    "agent",
    "adapttable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://adapttable.orwamahmoud.com/angular/demo/unstyled/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/angular/ai-angular"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "module": "./dist/fesm2022/adapttable-ai-angular.mjs",
  "types": "./dist/types/adapttable-ai-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/adapttable-ai-angular.d.ts",
      "default": "./dist/fesm2022/adapttable-ai-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && node -e \"require('node:fs').rmSync('dist/package.json')\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@adapttable/ai": "0.6.0",
    "@adapttable/angular": "0.5.0",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "ng-packagr": "^22.2.1",
    "rxjs": "^7.8.2",
    "@adapttable/angular-unstyled": "workspace:*",
    "@adapttable/core": "3.9.0"
  }
}
