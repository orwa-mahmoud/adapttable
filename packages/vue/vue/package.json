{
  "version": "0.1.0",
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc --noEmit && node ../../../scripts/check-vue-types.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage .turbo"
  },
  "name": "@adapttable/vue",
  "description": "Headless Vue composables and structural table contracts for AdaptTable.",
  "dependencies": {
    "@adapttable/core": "3.8.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.ts",
        "default": "./dist/adapter.js"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./features": {
      "import": {
        "types": "./dist/features.d.ts",
        "default": "./dist/features.js"
      },
      "require": {
        "types": "./dist/features.d.cts",
        "default": "./dist/features.cjs"
      }
    },
    "./package.json": "./package.json",
    "./filters": {
      "import": {
        "types": "./dist/filters.d.ts",
        "default": "./dist/filters.js"
      },
      "require": {
        "types": "./dist/filters.d.cts",
        "default": "./dist/filters.cjs"
      }
    },
    "./header-filters": {
      "import": {
        "types": "./dist/header-filters.d.ts",
        "default": "./dist/header-filters.js"
      },
      "require": {
        "types": "./dist/header-filters.d.cts",
        "default": "./dist/header-filters.cjs"
      }
    },
    "./editing": {
      "import": {
        "types": "./dist/editing.d.ts",
        "default": "./dist/editing.js"
      },
      "require": {
        "types": "./dist/editing.d.cts",
        "default": "./dist/editing.cjs"
      }
    },
    "./batch-editing": {
      "import": {
        "types": "./dist/batch-editing.d.ts",
        "default": "./dist/batch-editing.js"
      },
      "require": {
        "types": "./dist/batch-editing.d.cts",
        "default": "./dist/batch-editing.cjs"
      }
    },
    "./density": {
      "import": {
        "types": "./dist/density.d.ts",
        "default": "./dist/density.js"
      },
      "require": {
        "types": "./dist/density.d.cts",
        "default": "./dist/density.cjs"
      }
    },
    "./fullscreen": {
      "import": {
        "types": "./dist/fullscreen.d.ts",
        "default": "./dist/fullscreen.js"
      },
      "require": {
        "types": "./dist/fullscreen.d.cts",
        "default": "./dist/fullscreen.cjs"
      }
    },
    "./saved-views": {
      "import": {
        "types": "./dist/saved-views.d.ts",
        "default": "./dist/saved-views.js"
      },
      "require": {
        "types": "./dist/saved-views.d.cts",
        "default": "./dist/saved-views.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/vue/vue"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "publishConfig": {
    "access": "public"
  }
}
