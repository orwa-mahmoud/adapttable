          </p>
        </div>
        <div class="getstarted">
          <pre
            class="getstarted__code"><code>{`import { DataTable } from "@adapttable/mantine"; // or mui, chakra, antd, radix, base-ui, shadcn, unstyled

<DataTable
  data={people}
  columns={[
    { key: "name" },
    { key: "team", filter: "multiSelect" },
    { key: "hiredAt", filter: "dateRange" },
  ]}
/>`}</code></pre>
          <div class="getstarted__actions">
            <div class="install install--lg">
