{
  "name": "@adapttable/angular",
  "version": "0.3.0",
  "description": "Headless Angular binding for AdaptTable. Signals over the framework-neutral engine in @adapttable/core.",
  "keywords": [
    "angular",
    "signals",
    "data-table",
    "table",
    "headless",
    "headless-ui",
    "datagrid",
    "adapttable"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://adapttable.orwamahmoud.com/react/demo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/angular/angular"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "module": "./dist/fesm2022/adapttable-angular.mjs",
  "types": "./dist/types/adapttable-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/adapttable-angular.d.ts",
      "default": "./dist/fesm2022/adapttable-angular.mjs"
    },
    "./formula": {
      "types": "./dist/types/adapttable-angular-formula.d.ts",
      "default": "./dist/fesm2022/adapttable-angular-formula.mjs"
    },
    "./pivot": {
      "types": "./dist/types/adapttable-angular-pivot.d.ts",
      "default": "./dist/fesm2022/adapttable-angular-pivot.mjs"
    },
    "./router": {
      "types": "./dist/types/adapttable-angular-router.d.ts",
      "default": "./dist/fesm2022/adapttable-angular-router.mjs"
    },
    "./sparkline": {
      "types": "./dist/types/adapttable-angular-sparkline.d.ts",
      "default": "./dist/fesm2022/adapttable-angular-sparkline.mjs"
    },
    "./stream": {
      "types": "./dist/types/adapttable-angular-stream.d.ts",
      "default": "./dist/fesm2022/adapttable-angular-stream.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && node -e \"require('node:fs').rmSync('dist/package.json')\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/router": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@tanstack/angular-query-experimental": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    },
    "@tanstack/angular-query-experimental": {
      "optional": true
    }
  },
  "dependencies": {
    "@adapttable/core": "3.8.0",
    "@tanstack/angular-virtual": "^6.0.6",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@tanstack/angular-query-experimental": "^5.104.0",
    "ng-packagr": "^22.2.1",
    "rxjs": "^7.8.2"
  }
}
