  "standardFeatures": {
    "note": "`standardFeatures()` with no arguments returns only factories that are callable with no required configuration. A factory that needs options is inert without them, so naming it in a preset would bundle an implementation the table cannot use. Those join through `standardFeatures({ ... })` when the caller supplies what they need. A factory that is callable bare but does nothing without a host prop or a sibling feature is not a member either: the preset composes what WORKS with no further input.",
    "zeroArgument": [
      "columnMenu",
      "densityChooser",
      "exportCsv",
      "findInTable",
      "fitColumns",
      "fullscreen",
      "headerFilters",
      "multiSort",
      "resizableColumns",
      "statusBar"
    ],
    "onlyWithOptions": ["bulkActions", "filters", "grouping", "savedViews"]
  },
  "loading": {
    "rule": "Feature subpaths are imported statically. A lazy variant is a separate, explicitly measured export, admitted only with evidence that initial-open SSR, hydration, focus order and first use are unchanged. No feature is named a lazy candidate in advance."
  },
  "provisionalBaseReview": {
    "note": "Four capabilities were carried as provisional base members and measured before the contract was fixed. The test is both halves: essential to the three-prop table AND cheap. Each is cheap; none is reachable from `columns` + `data` + `rowKey` alone, so none stays in base. Sizes are that module's own graph bundled with React and the kits external, minified and gzipped — an upper bound, because a shared dependency is counted against every module that reaches it.",
    "method": "rolldown over packages/core/src, React and @tanstack external, minify + gzip",
    "reviewed": {
      "row selection": {
        "module": "core/src/selection/useSelection.ts",
        "sizeKB": 0.79,
        "essentialToThreeProp": false,
        "verdict": "feature",
        "where": "The selection model is what `columnSelectionCheckbox`, `bulkActions` and `selectionStats` need; a three-prop table renders no checkbox and no bulk bar. Item 4 moves the hook behind those features."
      },
      "row actions": {
        "module": "core/src/rows/rowActions.ts",
        "sizeKB": 0.1,
        "essentialToThreeProp": false,
        "verdict": "feature",
        "where": "The trailing action column renders only when the host passes `rowActions`, and the buttons are the kit's own. Item 4 gives it a factory and its adapter contribution."
      },
      "column visibility": {
        "module": "core/src/columns/useColumnLayout.ts",
        "sizeKB": 1.9,
        "essentialToThreeProp": false,
        "verdict": "feature",
        "where": "Resolving which columns render is base and stays; CHANGING that set is the Columns menu. `columnMenu` already owns the control, its URL state and its storage."
      },
      "column order": {
        "module": "core/src/columns/columnReorder.ts",
        "sizeKB": 0.91,
        "essentialToThreeProp": false,
        "verdict": "feature",
        "where": "Initial order is the `columns` array, which is base. Reordering is reached only through the Columns menu — `columnReorderKeyProps` is imported by adapter ColumnMenu components and nothing else — so it ships with `columnMenu`."
      }
    }
  },
  "seamMeasurement": {
    "note": "What the provider seam costs and what the first feature through it removed, so the trade is a number rather than a claim. Packed figures come from scripts/bundle-budget.mjs; module figures are that module's own graph bundled with React and the kits external, minified and gzipped.",
    "providerLayerKB": 0.74,
    "rowReorderModuleKB": 1.51,
    "packedAdapterRootDeltaKB": -0.7,
