{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@adapttable/taiga-ui": ["./src/index.ts"],
      "@adapttable/taiga-ui/*": ["./*/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "include": [
    "cell-span",
    "extra-rows",
    "row-appearance",
    "src",
    "batch-editing",
    "bulk-actions",
    "cell-navigation",
    "column-groups",
    "column-menu",
    "column-selection",
    "command-palette",
    "context-menu",
    "density",
    "editing",
    "export",
    "features",
    "find-in-table",
    "filters",
    "fit-columns",
    "fullscreen",
    "grouping-panel",
    "header-filters",
    "multi-sort",
    "nested-table",
    "pinned-summary-rows",
    "preset",
    "pivot",
    "print",
    "resizable-columns",
    "row-actions",
    "row-detail",
    "row-pinning",
    "row-reorder",
    "saved-views",
    "selection-stats",
    "side-panel",
    "status-bar",
    "tree",
    "virtualize",
    "vitest.config.ts",
    "vitest.setup.ts",
    "assistant"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
