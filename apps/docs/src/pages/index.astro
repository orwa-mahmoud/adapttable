                  {f.viz === "a11y" && (
                    <span class="viz-a11y">
                      <i class="viz-kbd">Tab</i>
                      <i class="viz-focus">Name ↑</i>
                      <code>aria-sort="ascending"</code>
                    </span>
                  )}
                </div>
                <h3>{f.title}</h3>
                <p set:html={f.body.replace(/`([^`]+)`/g, "<code>$1</code>")} />
              </article>
            ))
          }
        </div>
        </div>
      </section>

