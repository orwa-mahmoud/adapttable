# Fast per-commit guard: formatting only, so commits stay instant. Pre-push
# runs the path-aware gate (check:if-needed + e2e:if-needed). CI still
# guards the PR.
# Hooks inherit the committing tool's PATH; GUI clients and non-interactive
# shells may not carry pnpm there — corepack ships with Node and resolves
# the pinned pnpm either way.
if command -v pnpm >/dev/null 2>&1; then
  pnpm format:check
else
  corepack pnpm format:check
fi
