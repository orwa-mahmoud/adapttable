{
  "name": "@adapttable/ai-react",
  "version": "0.2.6",
  "description": "React bindings for AdaptTable AI — tableAgent and useTableAssistant.",
  "keywords": [
    "react",
    "data-table",
    "ai",
    "agent",
    "adapttable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://adapttable.orwamahmoud.com/react/demo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/react/ai-react"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@adapttable/ai": "0.3.0",
    "@adapttable/core": "3.3.0",
    "@adapttable/react": "1.3.3",
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
