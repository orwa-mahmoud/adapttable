{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `pages.mjs` and `matrix.mjs` — the page manifest and the adapter ×
    // feature content the build scripts, the sitemap and the app all read —
    // are plain JS so Node can import them without a build step. Reading them
    // here types the generated Rollup input and the pages built from the
    // matrix, and checking them holds their JSDoc to the same bar as the
    // TypeScript around it.
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@adapttable/core/pdf": ["../../packages/core/src/pdf.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "matrix.mjs", "pages.mjs"],
  "exclude": ["src/**/*.test.ts"]
}
