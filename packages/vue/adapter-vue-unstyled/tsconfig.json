{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@adapttable/vue-unstyled": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage", "test/types/invalid"],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  }
}
