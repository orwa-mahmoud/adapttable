{
  "version": "0.8.1",
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tanstack/vue-query": "5.104.2",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown && node ../../../scripts/share-map-sources.mjs",
    "typecheck": "vue-tsc --noEmit && node ../../../scripts/check-vue-types.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage .turbo"
  },
  "name": "@adapttable/vue",
  "description": "Headless Vue composables and structural table contracts for AdaptTable — sorting, filtering, editing, grouping, URL state and server data over the framework-neutral engine.",
  "keywords": [
    "vue",
    "vue3",
    "data-table",
    "table",
    "datagrid",
    "headless",
    "composables",
    "typescript",
    "adapttable"
  ],
  "dependencies": {
    "@adapttable/core": "4.1.0",
    "@adapttable/i18n": "4.0.1",
    "@tanstack/virtual-core": "^3.17.11"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "development": "./dist/dev/index.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "development": "./dist/dev/index.cjs",
        "default": "./dist/index.cjs"
