{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@adapttable/ai-vue": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  }
}
