---
// Static landing at the site root, wearing the DEMO's chrome verbatim —
// the same tokens, sticky nav, hero composition, section scaffolding,
// get-started block and footer as /demo, so the funnel reads as one
// product. Pre-rendered text + JSON-LD carry the SEO; the live demo
// stays at /demo, the guide at /getting-started/.
const SITE = "https://orwa-mahmoud.github.io/adapttable";
const REPO = "https://github.com/orwa-mahmoud/adapttable";
const TITLE = "AdaptTable — Headless React Data Table for Any UI Kit";
const DESCRIPTION =
  "One React data table, rendered natively by Mantine, MUI, Chakra, Ant Design, Radix, Base UI or shadcn/ui — filters, URL-synced state, virtualization, RTL. MIT, headless core.";

// The demo hero's adapter chips, same labels and accent colors as
// apps/showcase/src/themeTokens.ts.
const KITS = [
  { label: "Mantine", c: "oklch(0.58 0.17 252)" },
  { label: "MUI", c: "oklch(0.55 0.18 264)" },
  { label: "Chakra", c: "oklch(0.6 0.1 188)" },
  { label: "Ant Design", c: "oklch(0.56 0.2 262)" },
  { label: "Radix", c: "oklch(0.54 0.19 280)" },
  { label: "Base UI", c: "oklch(0.55 0.19 255)" },
  { label: "shadcn / Tailwind", c: "oklch(0.28 0.01 264)" },
  { label: "Custom Tailwind", c: "oklch(0.55 0.2 277)" },
];

const FEATURES = [
  {
    viz: "filter",
    hue: "274",
    title: "Columns & filters",
    body: "One declaration drives the widget, the URL params, the chips and the row predicate. Operator-first number and date filters: Equal, At least, At most, Between.",
  },
  {
    viz: "tiers",
    hue: "210",
    title: "Three data tiers",
    body: "Hand the table an array and it filters, sorts and pages in memory. Or own the fetch: one consolidated query event with an abort signal. Or bring a full custom TableSource.",
  },
  {
    viz: "url",
    hue: "152",
    title: "URL-synced everything",
    body: "Search, sort, filters, pagination, column layout and saved views live in shareable URLs — namespaced per table, SSR-safe, with a one-prop opt-out (urlSync={false}).",
  },
  {
    viz: "rows",
    hue: "60",
    title: "50,000 rows, no flinching",
    body: "Opt-in virtualization windows the DOM against the page or any max-height scroll box. The live demo scrolls fifty thousand rows with a handful of DOM nodes.",
  },
  {
    viz: "i18n",
    hue: "25",
    title: "i18n & RTL, for real",
    body: "Label presets for ten locales. Columns map per-locale data paths, so cells, sorting and filtering follow the language. Pinning and layout are logical — Arabic and Hebrew just work.",
  },
  {
    viz: "columns",
    hue: "330",
    title: "Column management",
    body: "Show, hide, reorder, pin and resize — the row-actions column included. Capture any state as a named saved view and restore it later, per table.",
  },
  {
    viz: "bulk",
    hue: "10",
    title: "Selection & bulk actions",
    body: "Select the page — or all matches across every page. Bulk actions run through an injectable confirm, and per-row actions explain themselves with disabledReason.",
  },
  {
    viz: "a11y",
    hue: "120",
    title: "Accessible by default",
    body: "Real table roles, aria-sort, focus management and full keyboard navigation — column reorder and resize included, straight from the keyboard.",
  },
];

// The customization spectrum — moved here from the demo: it's a story,
// not a live table, so it belongs on the marketing page.
const SPECTRUM = [
  {
    t: "Props",
    d: "Pass data + columns. Sensible defaults do the rest.",
    code: "<DataTable source={src}\n  columns={cols} />",
  },
  {
    t: "Slots",
    d: "Swap the empty, loading, and skeleton states.",
    code: "slots={{ empty: <NoResults/>,\n  skeleton: <Shimmer/> }}",
  },
  {
    t: "classNames + data-*",
    d: "Style any part; target rows by state.",
    code: "classNames={{ row: 'hover:bg…' }}\n// [data-selected] [data-pinned]",
  },
  {
    t: "Custom toolbar",
    d: "Inject your own toolbar + confirm dialog.",
    code: "renderToolbar={(api) => …}\nconfirm={myConfirm}",
  },
  {
    t: "Fully headless",
    d: "Prop-getters. You own every element.",
    code: "const { getRowProps,\n  getHeaderProps } = useTable()",
  },
];


const ROWS = [
  { i: "AL", name: "Ada Lovelace", role: "Engineer", s: "Planned", tone: "blue", money: "$25,300", load: 56 },
  { i: "AT", name: "Alan Turing", role: "Founder", s: "Blocked", tone: "red", money: "$32,600", load: 67 },
  { i: "KJ", name: "Katherine Johnson", role: "Researcher", s: "Active", tone: "green", money: "$47,200", load: 89 },
];

const JSON_LD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "AdaptTable",
  description: DESCRIPTION,
  url: `${SITE}/`,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  license: "https://opensource.org/license/mit",
  programmingLanguage: "TypeScript",
  codeRepository: REPO,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
