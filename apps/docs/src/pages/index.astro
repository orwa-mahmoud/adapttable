            </div>
          </div>
        </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="foot__inner shell">
        <div class="foot__lead">
          <a class="wm" href={`${SITE}/`}>
            <svg
              class="wm__mark"
