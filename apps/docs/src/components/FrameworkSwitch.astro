---
import { DOCS_FRAMEWORKS, selectedFramework, frameworkDocsTarget } from "../../../../scripts/framework-navigation.mjs";
const current = selectedFramework(Astro.url.pathname);
---

<label class="framework-picker">
  <span aria-hidden="true" data-framework-icon>{DOCS_FRAMEWORKS.find(({ key }) => key === current)?.icon ?? "⚛"}</span>
  <span class="sr-only">Framework</span>
  <select aria-label="Framework" data-framework-select autocomplete="off">
    {DOCS_FRAMEWORKS.map(({key, label}) => <option value={key} selected={key === current} data-href={frameworkDocsTarget(Astro.url.pathname, key).href}>{label}</option>)}
  </select>
</label>

<style>
  .framework-picker { display: inline-flex; align-items: center; gap: .25rem; white-space: nowrap; color: var(--sl-color-gray-1); font-size: var(--sl-text-sm); }
  .framework-picker select { max-width: 7rem; font: inherit; color: inherit; background: transparent; border: 0; border-radius: .3rem; padding: .4rem .2rem; cursor: pointer; }
  .framework-picker select:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  .framework-picker option { color: var(--sl-color-text); background: var(--sl-color-bg); }
</style>
<script>
  import "../framework-navigation";
</script>
