          }
        </div>

        <figure class="mock reveal" aria-hidden="true">
          <div class="mock__toolbar">
            <span class="mock__search">⌕ Search people…</span>
            <span class="mock__spacer"></span>
            <span class="mock__chip">Team: Core ✕</span>
            <span class="mock__btn">≔ Filters <b>2</b></span>
            <span class="mock__btn">Columns</span>
          </div>
          <div class="mock__table">
            <div class="mock__row mock__row--head">
              <span>Person ↕</span><span>Status</span>
              <span class="num">Budget ↕</span><span>Load</span>
            </div>
