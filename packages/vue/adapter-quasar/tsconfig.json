      "@adapttable/quasar/export": ["./src/export.ts"],
      "@adapttable/quasar/export-pdf": ["./src/export-pdf.ts"],
      "@adapttable/quasar/export-xlsx": ["./src/export-xlsx.ts"],
      "@adapttable/quasar/tree": ["./src/tree.ts"],
      "@adapttable/quasar/row-detail": ["./src/row-detail.ts"],
      "@adapttable/quasar/row-actions": ["./src/row-actions.ts"],
      "@adapttable/quasar/row-pinning": ["./src/row-pinning.ts"],
      "@adapttable/quasar/pinned-summary-rows": [
        "./src/pinned-summary-rows.ts"
      ],
      "@adapttable/quasar/cell-span": ["./src/cell-span.ts"],
      "@adapttable/quasar/extra-rows": ["./src/extra-rows.ts"],
      "@adapttable/quasar/row-appearance": ["./src/row-appearance.ts"],
