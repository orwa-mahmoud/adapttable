{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@adapttable/reka-ui": ["./src/index.ts"],
      "@adapttable/reka-ui/*": ["./src/*.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "tsdown.config.ts",
    "browser",
    "vitest.packed-binding.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "test/types/invalid"],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  }
}
