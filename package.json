{
  "name": "adapttable-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "AdaptTable — a headless, UI-agnostic React data table with batteries-included adapters for Mantine, MUI, Chakra, Ant Design, Radix, and shadcn/ui, plus an unstyled path for Tailwind & your own CSS.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:e2e": "playwright test",
    "e2e:if-needed": "node scripts/e2e-if-needed.mjs",
    "check:if-needed": "node scripts/check-if-needed.mjs",
    "bench": "node scripts/bench.mjs",
    "lint": "turbo run lint",
    "lint:root": "eslint scripts vitest.shared.ts",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,mjs,cjs}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo coverage",
    "sonar:coverage": "turbo run test:coverage --force && node scripts/fix-lcov-paths.mjs",
    "llms": "node scripts/build-llms-full.mjs",
    "react:matrix": "node scripts/react-matrix.mjs",
    "peer:floors": "node scripts/peer-floors.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && prettier --write \".changeset/*.json\" \"packages/*/CHANGELOG.md\" \"packages/*/package.json\"",
    "release": "turbo run build && changeset publish",
    "verify:release": "pnpm run format:check && pnpm run lint && pnpm run lint:root && pnpm run check:readmes && pnpm run check:docsurface && pnpm run check:parts && pnpm run typecheck && pnpm run test:coverage --concurrency=1 && pnpm run build && pnpm run api:check && pnpm run publint && pnpm run smoke:dist && pnpm run budget && pnpm run consumer:harness && pnpm run peer:floors",
    "publint": "pnpm --filter \"./packages/*\" exec publint --strict",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run lint:root && pnpm run check:readmes && pnpm run check:docsurface && pnpm run check:parts && pnpm run typecheck && pnpm run test:coverage && pnpm run test:scripts && pnpm run build && pnpm run publint && pnpm run smoke:dist && pnpm run budget",
    "prepare": "husky",
    "check:kits-docs": "pnpm --filter @adapttable/cli exec vitest run src/kits-docs.test.ts",
    "check:readmes": "node scripts/check-readme-features.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:docsurface": "node scripts/check-doc-surface.mjs",
    "consumer:harness": "node scripts/consumer-harness.mjs",
    "api:reports": "node scripts/api-reports.mjs --local",
    "api:check": "node scripts/api-reports.mjs",
    "release:gated": "pnpm run build && pnpm run publint && changeset publish",
    "check:parts": "node scripts/check-parts-parity.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.11"
  }
}
