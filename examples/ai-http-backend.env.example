# Copy to examples/.env.ai-http (gitignored). Do not overwrite a root `.env`.
# Never put real keys in this file.

AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5.6-luna

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional. When set, the example requires Authorization: Bearer <token>.
# Required when AGENT_HOST is not loopback.
# AGENT_HTTP_TOKEN=

# Bind address. Default 127.0.0.1 (localhost only).
# AGENT_HOST=127.0.0.1

# Optional path to an env file. Existing process.env keys win.
# AGENT_ENV_FILE=

# Comma-separated. Defaults to local showcase ports when unset.
# AGENT_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# AGENT_PORT=8787
# AGENT_MAX_BODY=65536
