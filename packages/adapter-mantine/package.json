{
  "name": "@adapttable/mantine",
  "version": "2.6.0",
  "description": "Mantine adapter for AdaptTable — a batteries-included, themeable React data table with sorting, filtering, URL state, virtualization, RTL, dark mode, and responsive card rendering.",
  "keywords": [
    "react",
    "mantine",
    "data-table",
    "table",
    "datagrid",
    "mantine-datatable",
    "server-side-pagination",
    "url-state",
    "virtualized-table",
    "responsive-table",
    "rtl",
    "dark-mode",
    "typescript"
  ],
  "license": "MIT",
  "author": "Orwa Mahmoud",
  "homepage": "https://orwa-mahmoud.github.io/adapttable/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orwa-mahmoud/adapttable.git",
    "directory": "packages/adapter-mantine"
  },
  "bugs": "https://github.com/orwa-mahmoud/adapttable/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./features": {
      "import": {
        "types": "./dist/features.d.ts",
        "default": "./dist/features.js"
      },
      "require": {
        "types": "./dist/features.d.cts",
        "default": "./dist/features.cjs"
      }
    },
    "./row-reorder": {
      "import": {
        "types": "./dist/row-reorder.d.ts",
        "default": "./dist/row-reorder.js"
      },
      "require": {
        "types": "./dist/row-reorder.d.cts",
        "default": "./dist/row-reorder.cjs"
      }
    },
    "./saved-views": {
      "import": {
        "types": "./dist/saved-views.d.ts",
        "default": "./dist/saved-views.js"
      },
      "require": {
        "types": "./dist/saved-views.d.cts",
        "default": "./dist/saved-views.cjs"
      }
    },
    "./grouping": {
      "import": {
        "types": "./dist/grouping.d.ts",
        "default": "./dist/grouping.js"
      },
      "require": {
        "types": "./dist/grouping.d.cts",
        "default": "./dist/grouping.cjs"
      }
    },
    "./editing": {
      "import": {
        "types": "./dist/editing.d.ts",
        "default": "./dist/editing.js"
      },
      "require": {
        "types": "./dist/editing.d.cts",
        "default": "./dist/editing.cjs"
      }
    },
    "./virtualize": {
      "import": {
        "types": "./dist/virtualize.d.ts",
        "default": "./dist/virtualize.js"
      },
      "require": {
        "types": "./dist/virtualize.d.cts",
        "default": "./dist/virtualize.cjs"
      }
    },
    "./column-menu": {
      "import": {
        "types": "./dist/column-menu.d.ts",
        "default": "./dist/column-menu.js"
      },
      "require": {
        "types": "./dist/column-menu.d.cts",
        "default": "./dist/column-menu.cjs"
      }
    },
    "./cell-navigation": {
      "import": {
        "types": "./dist/cell-navigation.d.ts",
        "default": "./dist/cell-navigation.js"
      },
      "require": {
        "types": "./dist/cell-navigation.d.cts",
        "default": "./dist/cell-navigation.cjs"
      }
    },
    "./pivot": {
      "import": {
        "types": "./dist/pivot.d.ts",
        "default": "./dist/pivot.js"
      },
      "require": {
        "types": "./dist/pivot.d.cts",
        "default": "./dist/pivot.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@adapttable/core": "workspace:^",
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependencies": {
    "@mantine/core": "^7.2.0 || ^8.0.0 || ^9.0.0",
    "@mantine/hooks": "^7.2.0 || ^8.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
