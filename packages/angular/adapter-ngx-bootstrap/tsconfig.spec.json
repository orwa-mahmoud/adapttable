{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@adapttable/ngx-bootstrap": ["./src/index.ts"],
      "@adapttable/ngx-bootstrap/*": ["./*/index.ts"],
      "@adapttable/angular": ["../angular/src/index.ts"],
      "@adapttable/angular/features": ["../angular/src/features.ts"],
      "@adapttable/angular/adapter": ["../angular/src/adapter.ts"],
      "@adapttable/angular/*": ["../angular/*/index.ts"],
      "@adapttable/core": ["../../shared/core/src/index.ts"],
      "@adapttable/core/*": ["../../shared/core/src/*"]
    }
  },
  "include": [
    "cell-span",
    "extra-rows",
    "row-appearance",
    "src",
    "batch-editing",
    "bulk-actions",
    "cell-navigation",
    "column-groups",
    "column-menu",
    "column-selection",
    "command-palette",
    "context-menu",
    "density",
    "editing",
    "export",
    "features",
    "find-in-table",
    "filters",
    "fit-columns",
    "fullscreen",
    "grouping-panel",
    "header-filters",
    "multi-sort",
    "nested-table",
    "pinned-summary-rows",
    "preset",
    "pivot",
    "print",
    "resizable-columns",
    "row-actions",
    "row-detail",
    "row-pinning",
    "row-reorder",
    "saved-views",
    "selection-stats",
    "side-panel",
    "status-bar",
    "tree",
    "virtualize",
    "assistant"
  ]
}
