      "@adapttable/quasar/resizable-columns": ["./src/resizable-columns.ts"],
      "@adapttable/quasar/multi-sort": ["./src/multi-sort.ts"],
      "@adapttable/quasar/cell-navigation": ["./src/cell-navigation.ts"],
      "@adapttable/quasar/side-panel": ["./src/side-panel.ts"],
      "@adapttable/quasar/grouping-panel": ["./src/grouping-panel.ts"],
      "@adapttable/quasar/command-palette": ["./src/command-palette.ts"],
      "@adapttable/quasar/context-menu": ["./src/context-menu.ts"],
      "@adapttable/quasar/row-reorder": ["./src/row-reorder.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts", "tsdown.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".sfc-types",
