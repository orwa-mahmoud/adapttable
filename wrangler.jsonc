// The published site: the composed docs + showcase build, served by a Worker
// with static assets at the origin in scripts/site.mjs. The build writes
// `_redirects` beside the pages (scripts/build-redirects.mjs); the Worker
// reads it natively. The custom domain is attached to this Worker once, in the
// Cloudflare account, so a deploy only uploads assets.
{
  "name": "adapttable",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/docs/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
