{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "inlineSources": true,
    "allowImportingTsExtensions": false,
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  },
  "include": [
    "src",
    "features",
    "adapter",
    "formula",
    "pivot",
    "router",
    "sparkline",
    "stream"
  ],
  "exclude": ["**/*.test.ts"]
}
